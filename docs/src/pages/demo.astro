---
import MonacoPlayground from '../components/MonacoPlayground.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>golyglot Monaco demo</title>
		<meta name="description" content="Try golyglot's Go parser, formatter, and transpiler in Monaco." />
	</head>
	<body>
		<script is:inline src="/wasm_exec.js"></script>
		<header class="site-header">
			<a href="/">golyglot</a>
			<nav>
				<a href="/">Docs</a>
				<a href="https://github.com/renart-data/golyglot">GitHub</a>
			</nav>
		</header>
		<main>
			<p class="eyebrow">Go + WebAssembly</p>
			<h1>SQL playground</h1>
			<p class="lede">Edit SQL in Monaco and get diagnostics from the same pure-Go parser used by applications.</p>
			<MonacoPlayground />
		</main>
	</body>
</html>

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) {
		margin: 0;
		background: #10131a;
		color: #e8ecf3;
		font-family: Inter, ui-sans-serif, system-ui, sans-serif;
	}
	.site-header {
		display: flex;
		justify-content: space-between;
		padding: 1rem max(1rem, calc((100vw - 1100px) / 2));
		border-bottom: 1px solid #2b3240;
	}
	.site-header a { color: #e8ecf3; text-decoration: none; }
	nav { display: flex; gap: 1rem; }
	main { width: min(1100px, calc(100% - 2rem)); margin: 4rem auto; }
	.eyebrow { color: #72d6b2; font-size: .8rem; letter-spacing: .12em; text-transform: uppercase; }
	h1 { margin: .5rem 0; font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -.05em; }
	.lede { max-width: 650px; color: #aeb7c6; font-size: 1.1rem; }
</style>
